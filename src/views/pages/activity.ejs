<section class="page-intro">
  <div><p class="eyebrow">LATEST</p><h1>Recent activity</h1><p>Portal actions and signed admin events from connected websites.</p></div>
</section>
<% if (!events.length) { %>
  <section class="empty-state"><div class="empty-icon">◷</div><h2>No activity recorded</h2><p>Portal actions and signed client events will appear here as they happen.</p></section>
<% } else { %>
  <div class="activity-list activity-full">
    <% events.forEach((event) => { %>
      <article class="activity-row">
        <span class="activity-dot <%= event.source === 'EXTERNAL_WEBHOOK' ? 'activity-dot-green' : '' %>"></span>
        <div class="activity-main">
          <strong><%= event.summary %></strong>
          <small><%= event.project?.name || 'Control Portal' %> · <%= event.source === 'EXTERNAL_WEBHOOK' ? 'Signed client event' : 'Portal action' %><% if (event.actor?.name) { %> · <%= event.actor.name %><% } %></small>
          <% if (event.project) { %><a class="small-link" href="/projects/<%= event.project.slug %>/audit">Project audit log →</a><% } %>
        </div>
        <time datetime="<%= event.createdAt.toISOString() %>"><%= new Date(event.createdAt).toLocaleString() %></time>
      </article>
    <% }) %>
  </div>
<% } %>
