<!doctype html>
<html lang="en" data-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/portal-v2.css"></head>
<body class="auth-body"><main class="auth-shell"><a class="auth-brand" href="/"><span class="brand-logo-switch" aria-hidden="true"><img class="brand-logo-dark" src="/icons/portal-logo-dark.svg" alt=""><img class="brand-logo-light" src="/icons/portal-logo-light.svg" alt=""></span><strong>Control Portal</strong></a><section class="auth-card error-card"><p class="eyebrow">HTTP <%= statusCode || 500 %></p><h1><%= title %></h1><p><%= message %></p><a class="button button-primary button-wide" href="/">Return to dashboard</a></section></main></body></html>
