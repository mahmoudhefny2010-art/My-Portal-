<section class="workspace-heading">
  <div class="workspace-title-row">
    <a class="back-link" href="/projects">← Back to Projects</a>
    <div class="workspace-title">
      <span class="project-icon workspace-icon">
        <% if (project.faviconUrl) { %><img src="<%= project.faviconUrl %>" alt="" referrerpolicy="no-referrer"><% } else { %><%= project.name.slice(0, 1).toUpperCase() %><% } %>
      </span>
      <div><p class="eyebrow">PROJECT WORKSPACE</p><h1><%= project.name %></h1><a class="project-url" href="<%= project.siteUrl %>" target="_blank" rel="noopener noreferrer"><%= project.siteUrl %></a></div>
    </div>
    <div class="workspace-actions">
      <span class="status-pill status-<%= project.status.toLowerCase() %>"><i></i><%= project.status === 'UNKNOWN' ? 'Not checked' : project.status.toLowerCase() %></span>
      <% if (canManage) { %>
        <form action="/projects/<%= project.slug %>/check" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-secondary" type="submit">↻ Refresh check</button></form>
      <% } %>
      <button class="button button-secondary" type="button" data-fullscreen="<%= canEmbed ? 'project-frame' : '' %>" <%= canEmbed ? '' : 'disabled' %>>⛶ Fullscreen</button>
      <a class="button button-secondary" href="/integrations">Integration settings</a>
    </div>
  </div>
</section>

<section class="capability-strip">
  <div><span class="status-dot <%= project.integrationStatus === 'VERIFIED' ? 'status-dot-online' : 'status-dot-warning' %>"></span><strong><%= project.integrationStatus === 'VERIFIED' ? 'Embedding owner-verified' : 'Integration needs configuration' %></strong><small><%= project.integration?.framePolicyMessage || 'No verified dashboard integration is available yet.' %></small></div>
  <a class="text-link" href="/projects/<%= project.slug %>/audit">Project admin audit log →</a>
</section>

<% if (canEmbed) { %>
  <section class="embedded-workspace" aria-label="Original Admin Dashboard">
    <div class="embedded-bar"><span class="live-indicator"><i></i> Original Admin Dashboard</span><span class="embedded-origin"><%= project.integration.frameOrigin || project.adminUrl %></span><a href="<%= project.adminUrl %>" target="_blank" rel="noopener noreferrer">Open in new tab ↗</a></div>
    <iframe id="project-frame" class="project-frame" src="<%= project.adminUrl %>" title="<%= project.name %> original Admin Dashboard" referrerpolicy="no-referrer" sandbox="allow-forms allow-scripts allow-same-origin allow-popups allow-downloads allow-modals" allowfullscreen></iframe>
  </section>
  <p class="fine-print">The embedded dashboard still uses its original authentication and backend. This owner-verified state can become stale; refresh the integration check if the client site changes.</p>
<% } else { %>
  <section class="workspace-empty">
    <div class="workspace-empty-visual" aria-hidden="true"><div class="workspace-window"><div class="workspace-window-top"><i></i><i></i><i></i></div><div class="workspace-window-content"><span></span><span></span><span></span><b>↗</b></div></div></div>
    <p class="eyebrow">ORIGINAL DASHBOARD NOT EMBEDDED</p>
    <h2>Finish the secure integration review</h2>
    <p><%= project.integration?.framePolicyMessage || 'The portal has not verified that the original dashboard can be embedded and authenticated securely.' %> You can still open the original site directly using the clearly labeled link below.</p>
    <div class="quick-actions centered-actions">
      <a class="button button-primary" href="<%= project.adminUrl %>" target="_blank" rel="noopener noreferrer">Open original Admin Dashboard <span aria-hidden="true">↗</span></a>
      <a class="button button-secondary" href="/integrations">Review integration steps</a>
      <% if (project.integrationStatus !== 'VERIFIED') { %><a class="button button-secondary" href="/projects/<%= project.slug %>/audit">View received admin events</a><% } %>
    </div>
    <div class="callout callout-warning workspace-warning"><strong>No synchronization is claimed yet</strong><p>Audit events, live data updates, and conflict protection need changes in the original website. The portal shows these capabilities as pending until verified evidence arrives.</p></div>
  </section>
<% } %>

<section class="workspace-meta-grid">
  <article class="panel compact-panel"><p class="eyebrow">CONNECTION</p><strong><%= project.status === 'UNKNOWN' ? 'No successful check recorded' : project.status.toLowerCase() %></strong><small><%= project.statusMessage || 'Run a check to measure the Admin URL response.' %></small></article>
  <article class="panel compact-panel"><p class="eyebrow">LAST HEALTH CHECK</p><strong><%= project.lastHealthCheckAt ? new Date(project.lastHealthCheckAt).toLocaleString() : 'Not checked yet' %></strong><small><%= project.responseMs === null ? 'Response time not measured' : project.responseMs + ' ms response' %></small></article>
  <article class="panel compact-panel"><p class="eyebrow">LAST ACTIVITY</p><strong><%= project.lastActivityAt ? new Date(project.lastActivityAt).toLocaleString() : 'No external activity received' %></strong><small>Only signed events from the client integration appear here.</small></article>
</section>

<% if (projectAccess.canManage) { %>
  <section class="workspace-admin-tools">
    <a class="button button-secondary" href="/projects/<%= project.slug %>/edit">Edit project details</a>
    <form action="/projects/<%= project.slug %>/archive" method="post" data-confirm="Archive this record in Control Portal? The original website will not be changed.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="button button-secondary" type="submit">Archive project</button>
    </form>
    <% if (currentUser.role === 'SUPER_ADMIN') { %>
      <form class="remove-project-form" action="/projects/<%= project.slug %>/remove" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="confirm-project-name">Remove only this portal record. Type <strong><%= project.name %></strong> to confirm.</label>
        <div><input id="confirm-project-name" name="confirmName" type="text" autocomplete="off" required><button class="button button-danger" type="submit">Remove from portal</button></div>
      </form>
    <% } %>
  </section>
<% } %>
