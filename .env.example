NODE_ENV=development
PORT=3000
PORTAL_NAME=Control Portal
PORTAL_ORIGIN=http://localhost:3000

# Optional Google OpenID Connect sign-in. Add PORTAL_ORIGIN/auth/google/callback
# as an authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional OneSignal Web Push. Keep the REST API key server-side; do not add it to browser code.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Use Neon pooled URL for requests and the direct URL for Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&connect_timeout=15&max_idle_connection_lifetime=30
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&connect_timeout=15

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
RATE_LIMIT_SECRET=
# 32-byte hex key. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_KEY_ENCRYPTION_KEY=
# Set before deploying the Vercel cron endpoint.
CRON_SECRET=

# Used only by npm run owner:create. Never set a default account or password.
PORTAL_OWNER_NAME=
PORTAL_OWNER_EMAIL=
PORTAL_OWNER_PASSWORD=
